# Copiez ce fichier vers .streamlit/secrets.toml et remplissez vos clés.
# NE COMMITEZ JAMAIS secrets.toml sur GitHub.

# === Base de données utilisateurs (OBLIGATOIRE en production) ===
# Sans DATABASE_URL, les comptes sont stockés en SQLite local et EFFACÉS à chaque redéploiement.
#
# Streamlit Cloud (connexions courtes) — Transaction pooler, port 6543.
# Pour rester dans l'UE, créez le projet Supabase en « West EU (Paris) » (eu-west-3),
# pas Londres (eu-west-2, hors UE) ni Zurich.
# DATABASE_URL = "postgresql://postgres.xxxxx@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"
#
# Serveur UE qui reste allumé (Fly Paris / OVH France) — Session pooler, port 5432 :
# DATABASE_URL = "postgresql://postgres.xxxxx@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"
# DATABASE_POOL_MODE = "session"
# === Administration (https://dowsonbost.streamlit.app/dashboard) ===
# Uniquement ces e-mails + mots de passe ont accès à l'espace admin.
# ADMIN_EMAIL = "vous@votre-domaine.com"
# ADMIN_PASSWORD = "choisissez-un-mot-de-passe-fort"
#
# Plusieurs administrateurs (même ordre e-mail / mot de passe) :
# ADMIN_EMAILS = ["vous@domaine.com", "autre@domaine.com"]
# ADMIN_PASSWORDS = ["mot-de-passe-1", "mot-de-passe-2"]

# === IA — matching parallèle : jusqu'à 8 clés Groq + 8 clés Gemini ===
# 5 clés Gemini accélèrent fortement le matching (1 offre par clé en même temps).
# Formats acceptés : liste TOML, ou clés numérotées GEMINI_API_KEY_2 … _5.

GROQ_API_KEY = "gsk_premiere_cle_complete_..."
GROQ_API_KEYS = [
    "gsk_deuxieme_cle_complete_...",
    "gsk_troisieme_cle_complete_...",
]

GEMINI_API_KEY = "AQ.premiere_cle_..."
GEMINI_API_KEY_2 = "AQ.deuxieme_cle_..."
GEMINI_API_KEY_3 = "AQ.troisieme_cle_..."
GEMINI_API_KEY_4 = "AQ.quatrieme_cle_..."
GEMINI_API_KEY_5 = "AQ.cinquieme_cle_..."
# Variante liste (équivalent) :
# GEMINI_API_KEYS = [
#     "AQ.deuxieme_cle_...",
#     "AQ.troisieme_cle_...",
#     "AQ.quatrieme_cle_...",
#     "AQ.cinquieme_cle_...",
# ]

# Secours optionnel (crédits requis) :
# OPENAI_API_KEY = "sk-..."

# === Moteurs d'emploi ===
ADZUNA_APP_ID = "votre_app_id"
ADZUNA_APP_KEY = "votre_app_key"

# Jooble (gratuit) — https://fr.jooble.org/api/about
# JOOBLE_API_KEY = "votre_cle_jooble"

# OptionCarriere / Careerjet (gratuit) — https://www.optioncarriere.com/partners/api
# CAREERJET_API_KEY = "votre_cle_careerjet"
# CAREERJET_REFERER = "https://votre-app.streamlit.app/"   # URL EXACTE enregistrée chez Careerjet
# CAREERJET_USER_IP = ""   # optionnel — laisser vide pour auto-détection (IP visiteur ou serveur)

# SerpApi — Indeed, LinkedIn, Glassdoor, Google Jobs + secours HelloWork/Monster/Talent.com
# https://serpapi.com/
# SERPAPI_API_KEY = "votre_cle_serpapi"

# Apify — JobTeaser, HelloWork, Monster, Talent.com (scrapers pay-per-use)
# https://console.apify.com/settings/integrations
# APIFY_API_TOKEN = "apify_api_..."

# === E-mails (optionnel mais requis pour confirmation de compte et candidatures) ===
# Inscription, confirmation de candidature, reset mot de passe, alertes d'offres.
# Option A — Resend (recommandé) : https://resend.com/
# RESEND_API_KEY = "re_..."
# EMAIL_FROM = "DowsonBost <alertes@votre-domaine.com>"

# Option B — SMTP classique
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "votre@email.com"
# SMTP_PASSWORD = "mot_de_passe_application"
# SMTP_FROM = "DowsonBost <votre@email.com>"
