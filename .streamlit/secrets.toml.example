# Copiez ce fichier vers .streamlit/secrets.toml et remplissez vos clés.
# NE COMMITEZ JAMAIS secrets.toml sur GitHub.

# === Base de données utilisateurs (OBLIGATOIRE en production / Streamlit Cloud) ===
# Sans DATABASE_URL, les comptes sont stockés en SQLite local et EFFACÉS à chaque redéploiement.
# Créez une base PostgreSQL gratuite sur Supabase (https://supabase.com) ou Neon (https://neon.tech),
# puis copiez l'URL de connexion (format postgresql://user:pass@host:5432/dbname).
# DATABASE_URL = "postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres"

# === IA — sélection AUTOMATIQUE (Groq → Gemini → OpenAI) ===
GROQ_API_KEY = "gsk_..."
GEMINI_API_KEY = "AQ...."   # ou AIza... — clés AI Studio (AQ. = format récent)
# OPENAI_API_KEY = "sk-..."  # secours optionnel (crédits requis)

# === Moteurs d'emploi ===
# Adzuna (gratuit) — https://developer.adzuna.com/
ADZUNA_APP_ID = "votre_app_id"
ADZUNA_APP_KEY = "votre_app_key"

# Welcome to the Jungle — aucune clé requise (activé par défaut)

# Jooble (gratuit, quota limité) — https://fr.jooble.org/api/about
# JOOBLE_API_KEY = "votre_cle_jooble"

# OptionCarriere / Careerjet (gratuit) — https://www.optioncarriere.com/partners/api
# CAREERJET_API_KEY = "votre_cle_careerjet"
# CAREERJET_USER_IP = "127.0.0.1"
# CAREERJET_REFERER = "https://localhost/"

# SerpApi — Indeed, LinkedIn, Glassdoor, Google Jobs — https://serpapi.com/
# SERPAPI_API_KEY = "votre_cle_serpapi"

# JobTeaser via Apify — https://apify.com/
# APIFY_API_TOKEN = "votre_token_apify"
